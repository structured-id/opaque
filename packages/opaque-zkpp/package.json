{
  "name": "@structured-id/opaque-zkpp",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-Knowledge Password Policy (ZKPP) prover: proves a password satisfies policy without revealing it. Patent-protected method; AGPL-3.0 with a separate commercial license available.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "bench": "vitest bench",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "zkpp",
    "zero-knowledge",
    "password-policy",
    "halo2",
    "snark",
    "cryptography"
  ],
  "author": "StructuredID <oss@structured.id>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/structured-id/opaque.git",
    "directory": "packages/opaque-zkpp"
  },
  "bugs": {
    "url": "https://github.com/structured-id/opaque/issues"
  },
  "homepage": "https://github.com/structured-id/opaque/tree/main/packages/opaque-zkpp#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.14.1",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  }
}
